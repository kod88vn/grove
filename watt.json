      "path": "./apps/grove"
    },
    {
      "id": "nora",
      "path": "./apps/nora"
    },
    {
      "id": "games",
      "path": "./apps/games"
    },
    {
      "id": "shopping-list",
      "path": "./apps/shopping-list"
    },
    {
      "id": "reminders",
      "path": "./apps/reminders"
    }
  ]
}
