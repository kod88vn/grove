{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/3.52.4.json",
  "entrypoint": "grove",
  "server": {
    "hostname": "0.0.0.0",
    "port": 80
  },
  "metrics": {
    "hostname": "0.0.0.0",
    "port": 9090,
    "endpoint": "/metrics",
    "labels": {
      "app": "grove"
    }
  },
  "services": [
    {
