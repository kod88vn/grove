{
  "name": "grove",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@1.17.3",
  "workspaces": ["packages/*","apps/*"],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --filter=@grove/grove --filter=nora --filter=@grove/games --filter=@grove/shopping-list --filter=@grove/reminders",
    "dev:orchestrator": "yarn workspace @grove/orchestrator dev",
    "build": "turbo run build --filter=@grove/grove --filter=nora --filter=@grove/games --filter=@grove/shopping-list --filter=@grove/reminders",
    "start": "platformatic start",
    "killp": "./scripts/killp.sh",
    "lint": "turbo run lint",
    "test:orchestrator": "yarn workspace @grove/orchestrator test",
    "test:games": "yarn workspace @grove/games test",
    "test": "turbo run test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "platformatic": "^3.53.0",
    "turbo": "^1.5.0"
  }
}
