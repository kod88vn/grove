{
  "name": "grove",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "resolutions": {
    "better-sqlite3": "^12.9.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "node --env-file=.env.local ./node_modules/turbo/bin/turbo run dev --filter=@grove/grove --filter=@grove/orchestrator --filter=nora --filter=@grove/games --filter=@grove/shopping-list --filter=@grove/reminders --filter=@grove/homeworks",
    "dev:orchestrator": "yarn workspace @grove/orchestrator dev",
    "build": "turbo run build --filter=@grove/grove --filter=nora --filter=@grove/games --filter=@grove/shopping-list --filter=@grove/reminders --filter=@grove/homeworks",
    "start": "platformatic start",
    "killp": "./scripts/killp.sh",
    "lint": "turbo run lint",
    "test:orchestrator": "yarn workspace @grove/orchestrator test",
    "test:games": "yarn workspace @grove/games test",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@platformatic/gateway": "^3.54.0",
    "husky": "^9.1.7",
    "platformatic": "^3.53.0",
    "turbo": "^2.9.12"
  }
}
