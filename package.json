{
  "name": "central-command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal work tracker: mirrors Jira and GitHub locally, detects stalled work, and surfaces the next move.",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch": "node .copilot-config/scripts/arch-check.mjs",
    "quality": "node .copilot-config/scripts/quality-check.mjs",
    "customizations": "node .copilot-config/scripts/validate-customizations.mjs \"$PWD\"",
    "guards": "npm run customizations && npm run arch && npm run quality",
    "verify": "npm run guards && npm run typecheck && npm run test",
    "cc": "tsx bin/cc.ts",
    "prepare": "git config core.hooksPath .githooks",
    "refresh": "tsx bin/cc.ts sync all --max-age-seconds=900",
    "dashboard": "tsx watch --clear-screen=false --exclude \"data/**\" --exclude \"reports/**\" bin/cc.ts serve"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
