{
  "name": "grove",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@1.17.3",
  "workspaces": ["packages/*","apps/*"],
  "scripts": {
    "dev": "turbo run dev --filter=nora",
    "dev:apps": "turbo run dev --filter=./apps/* --filter=!./apps/ai-skill-library",
    "dev:orchestrator": "turbo run dev --filter=@grove/orchestrator",
    "killp": "./scripts/killp.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test:orchestrator": "yarn workspace @grove/orchestrator test",
    "test:games": "yarn workspace @grove/games test",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^1.5.0"
  }
}
