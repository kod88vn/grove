{
  "version": "2.0.0",
  "tasks": [
    {
      // Refresh the mirror when the folder opens, so the first question of the day is answered
      // from data minutes old rather than from wherever yesterday left off.
      //
      // `--max-age-seconds` makes this cheap and idempotent: reopening the window a few times
      // does not trigger a few more full syncs. Absolute node path because tasks run in a
      // non-login shell with no nvm on PATH.
      "label": "bot: refresh mirror",
      "type": "shell",
      "command": "/Users/jay.quach/.nvm/versions/node/v24.18.0/bin/node",
      "args": [
        "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
        "${workspaceFolder}/bin/bot.ts",
        "sync",
        "all",
        "--max-age-seconds=900"
      ],
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "bot: what needs a push",
      "type": "shell",
      "command": "/Users/jay.quach/.nvm/versions/node/v24.18.0/bin/node",
      "args": [
        "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
        "${workspaceFolder}/bin/bot.ts",
        "stalls"
      ],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "bot: dashboard",
      "type": "shell",
      "command": "/Users/jay.quach/.nvm/versions/node/v24.18.0/bin/node",
      "args": [
        "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
        "${workspaceFolder}/bin/bot.ts",
        "serve"
      ],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
