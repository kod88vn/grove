      "args": ["/Users/kod/Documents/Cline/MCP/context7-mcp/node_modules/@upstash/context7-mcp/dist/index.js"],
      "env": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      }
    },
    "github": {
      "command": "/Users/kod/Documents/Cline/MCP/github-mcp-server/github-mcp-server",
