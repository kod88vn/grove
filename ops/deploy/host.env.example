# Grove host environment — loaded by the host daemon from ~/.grove/host.env.
# Copy to ~/.grove/host.env (chmod 600) and fill in the values.
# ops/deploy/install-host.sh generates this file for you.

# GitHub API token used for polling commits/checks and reporting deploy status.
# (The `gh auth token` of the account that owns the repo is fine.)
GITHUB_TOKEN=

# Shared secret for the webhook. Set the same value as the GitHub repo secret
# GROVE_DEPLOY_TOKEN. Generate with: openssl rand -hex 32
GROVE_DEPLOY_TOKEN=

# The repo the daemon watches.
GROVE_REPO=kod88vn/grove

# Where the daemon checks out the repo for builds (default: ~/.grove/checkout).
# CHECKOUT_DIR=/Users/jayquach/.grove/checkout

# Daemon HTTP port for the webhook (Tailscale Funnel forwards to this).
# DAEMON_PORT=8080

# Polling interval for the GitHub fallback path.
# POLL_INTERVAL_SECONDS=60

# ── App runtime (injected into the grove-live container) ─────────────────────
# The local LM Studio OpenAI-compatible server on this machine.
# From inside Docker on macOS the host is reached via host.docker.internal.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
MODEL=qwen/qwen3.8-27b
AI_PROVIDER=lmstudio
GROVE_LOCATION=Duluth, Georgia, USA
NORA_DB_PATH=/data/nora.db

# OpenObserve stack (ops/openobserve/docker-compose.yml)
OPENOBSERVE_ROOT_USER_EMAIL=admin@grove.local
OPENOBSERVE_ROOT_USER_PASSWORD=
CADDY_BASIC_AUTH_USERNAME=grove-admin
CADDY_BASIC_AUTH_PASSWORD=

# ── Webhook reachability (Tailscale Funnel) ──────────────────────────────────
# Public base URL of this daemon's webhook (set the same value as the GitHub
# repo variable GROVE_DEPLOY_URL; the CI deploy job POSTs $URL/deploy/<token>).
# If the daemon is routed as a PATH prefix on a shared funnel host — e.g.
# https://studio.tail03716c.ts.net/grove — also set WEBHOOK_PATH_PREFIX to that
# path (/grove), because the proxy forwards the full path. When the URL is set
# and reachable, the daemon skips re-running `tailscale funnel` each hour.
# GROVE_DEPLOY_URL=
# WEBHOOK_PATH_PREFIX=
