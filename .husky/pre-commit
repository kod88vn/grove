#!/usr/bin/env sh
# Ensure Node is available when Git hooks are run from GUI apps (e.g. Sourcetree).
for p in "$HOME/.volta/bin" "/opt/homebrew/bin" "/usr/local/bin"; do
	case ":$PATH:" in
		*":$p:"*) ;;
		*) PATH="$p:$PATH" ;;
	esac
done

# Load nvm if present (common on macOS dev machines).
if [ -z "${NVM_DIR:-}" ]; then
	NVM_DIR="$HOME/.nvm"
fi
if [ -s "$NVM_DIR/nvm.sh" ]; then
	. "$NVM_DIR/nvm.sh"
fi

export PATH

if ! command -v node >/dev/null 2>&1; then
	echo "husky - node not found in PATH: $PATH"
	echo "husky - install Node or expose it to GUI apps (Sourcetree)"
	exit 127
fi

yarn test

# Optional AI pre-commit review (paid API, LOCAL ONLY — skippable with SKIP_AI_REVIEW=1).
# CI does not use a paid review API: the coding agent reviews each PR itself (free).
if [ "${SKIP_AI_REVIEW:-0}" != "1" ] && [ -n "${ANTHROPIC_API_KEY:-}" ]; then
	# Verify the anthropic package is already installed — do NOT install it silently.
	if ! python3 -c "import anthropic" 2>/dev/null; then
		echo ""
		echo "husky - ERROR: anthropic Python package is not installed."
		echo "husky - Install it once with: pip3 install anthropic"
		echo "husky - Then retry the commit."
		echo ""
		exit 1
	fi
	python3 .github/scripts/ai-precommit.py || exit 1
elif [ -z "${ANTHROPIC_API_KEY:-}" ]; then
	echo "husky - ANTHROPIC_API_KEY not set, skipping AI review"
fi
